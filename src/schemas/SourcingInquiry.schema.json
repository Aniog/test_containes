{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Work email address for follow-up"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or brand name (optional)"
    },
    "country": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Country or region of the buyer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Product category the buyer wants to source"
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Service the buyer needs"
    },
    "budget": {
      "type": "string",
      "maxLength": 50,
      "description": "Estimated order budget range (optional)"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Details about the product, quantity, quality requirements, destination, etc."
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "closed"],
      "default": "new",
      "description": "Internal follow-up status for the sales team"
    }
  },
  "required": ["name", "email", "country", "product", "service", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
