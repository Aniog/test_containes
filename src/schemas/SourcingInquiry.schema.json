{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Sender's full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Sender's email address"
    },
    "company": {
      "type": "string",
      "description": "Sender's company name"
    },
    "product_interest": {
      "type": "string",
      "description": "Products or categories of interest"
    },
    "quantity": {
      "type": "string",
      "description": "Estimated order quantity"
    },
    "target_price": {
      "type": "string",
      "description": "Target price per unit"
    },
    "message": {
      "type": "string",
      "description": "Detailed sourcing requirements"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the User record",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "product_interest", "message"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
