{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the inquiry"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone or WhatsApp number"
    },
    "country": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Country of the inquirer"
    },
    "product_category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Product category being sourced"
    },
    "order_volume": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order volume range"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of services needed"
    },
    "product_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed product description and requirements"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional message or notes"
    },
    "status": {
      "type": "string",
      "enum": ["new", "in_review", "quoted", "closed"],
      "default": "new",
      "description": "Current status of the inquiry"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the inquiry was created"
    }
  },
  "required": ["name", "email", "country", "product_category"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
