{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for follow-up communication"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or business name"
    },
    "country": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Country of the buyer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product description or category being sourced"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional details about the sourcing requirements"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "country", "product"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
