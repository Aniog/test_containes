{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or business name"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number or WhatsApp"
    },
    "product": {
      "type": "string",
      "maxLength": 500,
      "description": "Product or category being sourced"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated order quantity"
    },
    "timeline": {
      "type": "string",
      "maxLength": 200,
      "description": "Project timeline or urgency"
    },
    "message": {
      "type": "string",
      "maxLength": 5000,
      "description": "Additional details about the sourcing requirements"
    },
    "source": {
      "type": "string",
      "enum": ["contact_page", "home_page"],
      "description": "Which form the inquiry was submitted from"
    }
  },
  "required": ["name", "email", "product"],
  "additionalProperties": false,
  "x-security": {
    "x-ownerColumn": "user_id",
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner"] },
    "update": { "allow": ["owner"] },
    "delete": { "allow": ["owner"] }
  }
}
