{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "product": {
      "type": "string",
      "description": "The product being sourced"
    },
    "quantity": {
      "type": "string",
      "description": "Estimated quantity needed"
    },
    "destination": {
      "type": "string",
      "description": "Shipping destination"
    },
    "requirements": {
      "type": "string",
      "description": "Additional requirements or specifications"
    },
    "user_id": {
      "type": "integer",
      "description": "Reference to the user record",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "product", "quantity"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
