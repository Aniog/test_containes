{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "description": "Full name of the buyer or contact person"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address"
    },
    "company": {
      "type": "string",
      "maxLength": 150,
      "description": "Company or business name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the buyer"
    },
    "phone": {
      "type": "string",
      "maxLength": 30,
      "description": "Phone number including country code"
    },
    "product_category": {
      "type": "string",
      "enum": [
        "Electronics & Components",
        "Furniture & Home Decor",
        "Apparel & Textiles",
        "Industrial Machinery",
        "Packaging & Printing",
        "Health & Beauty",
        "Toys & Baby Products",
        "Sports & Outdoor",
        "Automotive Parts",
        "Other"
      ],
      "description": "Product category being sourced"
    },
    "product_description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "description": "Detailed description of the product to be sourced"
    },
    "target_quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Target order quantity or MOQ"
    },
    "target_price": {
      "type": "string",
      "maxLength": 100,
      "description": "Target unit price or budget range"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Supplier Sourcing",
          "Factory Audit",
          "Quality Inspection",
          "Production Follow-up",
          "Shipping Coordination",
          "Private Label / OEM"
        ]
      },
      "description": "Services the buyer requires"
    },
    "timeline": {
      "type": "string",
      "enum": [
        "As soon as possible",
        "Within 1 month",
        "1–3 months",
        "3–6 months",
        "No fixed timeline"
      ],
      "description": "Desired sourcing timeline"
    },
    "additional_notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Any additional requirements or context"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["full_name", "email", "product_description"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": [] },
    "update": { "allow": [] },
    "delete": { "allow": [] }
  }
}
