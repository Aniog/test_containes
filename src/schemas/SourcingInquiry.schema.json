{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for follow-up"
    },
    "company_name": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or business name"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number or WhatsApp contact"
    },
    "product_needed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Description of the product the buyer needs sourced"
    },
    "estimated_quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity or MOQ range"
    },
    "project_details": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Detailed project requirements, specs, timeline, and other notes"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "in_progress", "quoted", "closed"],
      "default": "new",
      "description": "Current status of the inquiry"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["full_name", "email", "product_needed", "project_details"],
  "additionalProperties": false,
  "x-security": {
    "x-ownerColumn": "user_id",
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner"] },
    "update": { "allow": ["owner"] },
    "delete": { "allow": ["owner"] }
  }
}
