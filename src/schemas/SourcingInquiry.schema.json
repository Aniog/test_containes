{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number"
    },
    "product_category": {
      "type": "string",
      "maxLength": 100,
      "description": "Product category selected by the inquirer"
    },
    "product_description": {
      "type": "string",
      "maxLength": 5000,
      "description": "Detailed description of the product requirements"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Requested quantity"
    },
    "target_price": {
      "type": "string",
      "maxLength": 100,
      "description": "Target price range"
    },
    "timeline": {
      "type": "string",
      "maxLength": 100,
      "description": "Desired timeline for delivery"
    },
    "additional_info": {
      "type": "string",
      "maxLength": 5000,
      "description": "Additional requirements or information"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "closed"],
      "default": "new",
      "description": "Status of the inquiry"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "product_category", "product_description"],
  "x-security": {
    "x-ownerColumn": "user_id",
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner", "admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
