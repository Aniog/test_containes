{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Full name of the person submitting the inquiry."
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 160,
      "description": "Business email address of the inquirer."
    },
    "company": {
      "type": "string",
      "maxLength": 160,
      "description": "Company name, if provided."
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country the buyer is based in."
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Description of the product the buyer wants to source."
    },
    "product_category": {
      "type": "string",
      "enum": [
        "Consumer Electronics",
        "Home & Living",
        "Apparel & Textiles",
        "Industrial & Hardware",
        "Beauty & Personal Care",
        "Outdoor & Sports",
        "Other"
      ],
      "description": "Category of product to source."
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity as entered by the buyer."
    },
    "target_price": {
      "type": "string",
      "maxLength": 100,
      "description": "Target price per unit as entered by the buyer."
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Supplier Sourcing",
          "Factory Verification",
          "Quality Inspection",
          "Production Follow-Up",
          "Shipping & Logistics",
          "Full Service (End-to-End)"
        ]
      },
      "description": "List of sourcing services the buyer is interested in."
    },
    "message": {
      "type": "string",
      "maxLength": 3000,
      "description": "Free-text project details, specs, timeline, or notes."
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "won", "lost"],
      "default": "new",
      "description": "Pipeline status of the inquiry."
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the Users record created/upserted for this inquirer.",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "country", "product"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
