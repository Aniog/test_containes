{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for follow-up"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the inquirer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product the inquirer wants to source from China"
    },
    "quantity": {
      "type": "string",
      "maxLength": 50,
      "description": "Estimated order quantity range"
    },
    "service_needed": {
      "type": "string",
      "maxLength": 100,
      "description": "Type of sourcing service requested"
    },
    "details": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional details about requirements, target price, timeline, etc."
    },
    "source_page": {
      "type": "string",
      "maxLength": 50,
      "description": "Which page the inquiry was submitted from (home or contact)"
    }
  },
  "required": ["name", "email", "product"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}