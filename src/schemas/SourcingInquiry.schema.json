{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Full name of the buyer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address"
    },
    "company": {
      "type": "string",
      "maxLength": 160,
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "maxLength": 40,
      "description": "Phone number with country code"
    },
    "product_category": {
      "type": "string",
      "maxLength": 120,
      "description": "Product category or item to source"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Project details and sourcing requirements"
    },
    "source": {
      "type": "string",
      "maxLength": 80,
      "default": "website",
      "description": "Lead source"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Submission timestamp"
    }
  },
  "required": ["name", "email"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
