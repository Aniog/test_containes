{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or business name of the inquirer"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country where the buyer is based"
    },
    "category": {
      "type": "string",
      "enum": [
        "Electronics & Components",
        "Furniture & Home Goods",
        "Apparel & Textiles",
        "Machinery & Industrial",
        "Plastics & Packaging",
        "Health & Beauty",
        "Toys & Games",
        "Sports & Outdoor",
        "Automotive Parts",
        "Other"
      ],
      "description": "Product category the buyer is interested in sourcing"
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "maxLength": 5000,
      "description": "Detailed description of the sourcing need, including product specs, quantity, and requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "in_review", "responded", "closed"],
      "default": "new",
      "description": "Internal status of the inquiry"
    }
  },
  "required": ["name", "email", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": [] },
    "update": { "allow": [] },
    "delete": { "allow": [] }
  }
}
