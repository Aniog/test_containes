{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the person submitting the inquiry"
    },
    "company": {
      "type": "string",
      "maxLength": 300,
      "description": "Company name of the person submitting the inquiry"
    },
    "country": {
      "type": "string",
      "maxLength": 200,
      "description": "Country of the person submitting the inquiry"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number or WhatsApp contact"
    },
    "service": {
      "type": "string",
      "enum": ["sourcing", "verification", "inspection", "monitoring", "shipping", "full", ""],
      "description": "Type of sourcing service requested"
    },
    "product": {
      "type": "string",
      "maxLength": 500,
      "description": "Description of the product the buyer needs sourced"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated quantity or order volume"
    },
    "message": {
      "type": "string",
      "maxLength": 5000,
      "description": "Additional details and requirements from the buyer"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewed", "contacted", "qualified", "closed"],
      "default": "new",
      "description": "Current status of the inquiry"
    },
    "source": {
      "type": "string",
      "enum": ["homepage", "contact", "other"],
      "default": "contact",
      "description": "Which form or page the inquiry came from"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the inquiry was submitted"
    }
  },
  "required": ["name", "email", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
