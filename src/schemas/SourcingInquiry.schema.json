{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "description": "Full name of the contact"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or business name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone or WhatsApp number"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the buyer"
    },
    "product_category": {
      "type": "string",
      "maxLength": 100,
      "description": "Product category selected from the dropdown"
    },
    "product_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed description of the product being sourced"
    },
    "target_quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Target order quantity (free text, e.g. 500 units)"
    },
    "target_price": {
      "type": "string",
      "maxLength": 100,
      "description": "Target unit price in USD (free text, e.g. $15-$20)"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Supplier Sourcing",
          "Factory Verification",
          "Quality Inspection",
          "Production Follow-up",
          "Shipping Coordination",
          "Price Negotiation",
          "Full Sourcing Service"
        ]
      },
      "uniqueItems": true,
      "description": "List of services the buyer is interested in"
    },
    "timeline": {
      "type": "string",
      "maxLength": 100,
      "description": "Required sourcing timeline selected from the dropdown"
    },
    "message": {
      "type": "string",
      "maxLength": 3000,
      "description": "Additional notes or context from the buyer"
    }
  },
  "required": ["name", "email", "product_description"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
