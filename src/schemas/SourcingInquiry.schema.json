{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Company name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number"
    },
    "country": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Country of the inquirer"
    },
    "product_category": {
      "type": "string",
      "enum": [
        "electronics",
        "consumer-electronics",
        "machinery",
        "textiles",
        "home",
        "hardware",
        "sports",
        "baby",
        "medical",
        "auto",
        "packaging",
        "lighting",
        "other"
      ],
      "description": "Product category of interest"
    },
    "product_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Detailed product description"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated order quantity"
    },
    "budget": {
      "type": "string",
      "maxLength": 200,
      "description": "Target unit price in USD"
    },
    "additional_info": {
      "type": "string",
      "maxLength": 3000,
      "description": "Additional notes or requirements"
    }
  },
  "required": ["name", "company", "email", "country", "product_category", "product_description"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] }
  }
}