{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Name of the person submitting the sourcing inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address for follow-up"
    },
    "company": {
      "type": "string",
      "maxLength": 160,
      "description": "Company or organization name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Buyer country or market"
    },
    "phone": {
      "type": "string",
      "maxLength": 40,
      "description": "Optional phone or WhatsApp number"
    },
    "product_category": {
      "type": "string",
      "maxLength": 140,
      "description": "Product category the buyer wants to source"
    },
    "product_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Details about the product, specification, target price, quantity, or sourcing need"
    },
    "service_needs": {
      "type": "array",
      "description": "Sourcing services requested by the buyer",
      "items": {
        "type": "string",
        "enum": ["supplier_search", "factory_verification", "price_negotiation", "quality_inspection", "production_follow_up", "shipping_coordination"]
      },
      "uniqueItems": true,
      "default": []
    },
    "annual_volume": {
      "type": "string",
      "maxLength": 120,
      "description": "Estimated order quantity or annual purchase volume"
    },
    "timeline": {
      "type": "string",
      "maxLength": 120,
      "description": "Expected sourcing or production timeline"
    },
    "shipping_destination": {
      "type": "string",
      "maxLength": 160,
      "description": "Destination country, port, or delivery region"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Submission timestamp"
    }
  },
  "required": ["full_name", "email", "product_description"],
  "additionalProperties": false,
  "x-security": {
    "create": {
      "allow": ["*"]
    }
  }
}
