{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of business"
    },
    "product_category": {
      "type": "string",
      "maxLength": 100,
      "description": "Product category to source"
    },
    "product_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed description of the product to source"
    },
    "estimated_quantity": {
      "type": "string",
      "maxLength": 50,
      "description": "Estimated order quantity"
    },
    "target_price": {
      "type": "string",
      "maxLength": 50,
      "description": "Target price per unit"
    },
    "timeline": {
      "type": "string",
      "maxLength": 100,
      "description": "Desired timeline for sourcing"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["supplier_search", "factory_verification", "quality_inspection", "production_followup", "shipping_coordination"]
      },
      "description": "Services the buyer is interested in"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional message or questions"
    }
  },
  "required": ["name", "email", "product_description"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
