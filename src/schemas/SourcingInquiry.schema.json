{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the inquiry"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone or WhatsApp number"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product name or description"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "budget": {
      "type": "string",
      "maxLength": 100,
      "description": "Target unit price or budget range"
    },
    "timeline": {
      "type": "string",
      "maxLength": 200,
      "description": "Desired delivery timeline"
    },
    "message": {
      "type": "string",
      "maxLength": 4000,
      "description": "Detailed requirements and additional notes"
    },
    "hear_about": {
      "type": "string",
      "maxLength": 100,
      "description": "How the user heard about SSourcing China"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "in_progress", "closed"],
      "default": "new",
      "description": "Status of the inquiry"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the inquiry was submitted"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the inquiry was last updated"
    }
  },
  "required": ["id", "name", "email", "product"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
