{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquiry submitter"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquiry submitter"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Description of the product the buyer wants to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional details or requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "in_progress", "completed", "closed"],
      "default": "new",
      "description": "Status of the sourcing inquiry"
    },
    "source": {
      "type": "string",
      "maxLength": 50,
      "default": "website",
      "description": "Source of the inquiry (e.g. website, referral)"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "product"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner"] }
  }
}
