{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Linked user ID",
      "x-foreignKey": "users.id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Sender Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Sender Email"
    },
    "company": {
      "type": "string",
      "description": "Company Name"
    },
    "product_category": {
      "type": "string",
      "enum": ["Electronics", "Furniture", "Apparel", "Industrial", "Home Decor", "Other"],
      "description": "Interest Category"
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "description": "Inquiry Details"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewed", "contacted", "closed"],
      "default": "new",
      "description": "Inquiry Status"
    }
  },
  "required": ["name", "email", "message"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner"] }
  },
  "x-ownerColumn": "user_id"
}
