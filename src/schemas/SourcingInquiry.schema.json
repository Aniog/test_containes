{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "description": "Table for storing sourcing inquiries from potential buyers.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "product": {
      "type": "string",
      "description": "Product they are interested in sourcing"
    },
    "quantity": {
      "type": "string",
      "description": "Target order quantity"
    },
    "message": {
      "type": "string",
      "description": "Additional details or questions"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "qualified", "unqualified", "closed"],
      "default": "new",
      "description": "Current status of the lead"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of submission"
    }
  },
  "required": ["name", "email", "product"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
