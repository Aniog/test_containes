{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this inquiry",
      "x-foreignKey": "users.id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name of the inquirer"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number of the inquirer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product the inquirer wants to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated quantity needed"
    },
    "budget": {
      "type": "string",
      "maxLength": 200,
      "description": "Budget range for the project"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Detailed requirements and project description"
    },
    "source": {
      "type": "string",
      "enum": ["homepage_form", "contact_page"],
      "description": "Which page/form the inquiry was submitted from"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "qualified", "converted", "closed"],
      "default": "new",
      "description": "Inquiry status in the CRM pipeline"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the inquiry was submitted"
    }
  },
  "required": ["name", "email", "product", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}