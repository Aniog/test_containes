{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Full name of the buyer submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address for follow-up"
    },
    "company": {
      "type": "string",
      "maxLength": 160,
      "description": "Company name of the overseas buyer"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country or market where the buyer is based"
    },
    "phone": {
      "type": "string",
      "maxLength": 60,
      "description": "Optional phone or messaging contact details"
    },
    "service_needed": {
      "type": "string",
      "enum": ["supplier_sourcing", "factory_verification", "quality_inspection", "production_follow_up", "shipping_coordination", "multiple_services"],
      "description": "Primary sourcing service requested by the buyer"
    },
    "product_category": {
      "type": "string",
      "maxLength": 160,
      "description": "Product category or item the buyer wants to source"
    },
    "estimated_quantity": {
      "type": "string",
      "maxLength": 120,
      "description": "Expected order quantity, MOQ target, or purchasing volume"
    },
    "timeline": {
      "type": "string",
      "maxLength": 120,
      "description": "Expected sourcing or production timeline"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "description": "Detailed sourcing requirements and context"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewing", "quoted", "closed"],
      "default": "new",
      "description": "Internal inquiry handling status"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the inquiry was submitted"
    }
  },
  "required": ["name", "email", "service_needed", "product_category", "message", "status", "created_at"],
  "additionalProperties": false,
  "x-security": {
    "create": {
      "allow": ["*"]
    }
  }
}
