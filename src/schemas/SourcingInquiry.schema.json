{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 200,
      "description": "Email address for follow-up communication"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company or business name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the buyer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product the buyer wants to source from China"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "timeline": {
      "type": "string",
      "maxLength": 200,
      "description": "Target timeline or delivery deadline"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional details, specifications, or requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewed", "quoted", "in_progress", "completed", "closed"],
      "default": "new",
      "description": "Current status of the sourcing inquiry"
    },
    "source": {
      "type": "string",
      "maxLength": 50,
      "description": "Where the inquiry came from (e.g. homepage_form, contact_page)"
    }
  },
  "required": ["name", "email", "product"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
