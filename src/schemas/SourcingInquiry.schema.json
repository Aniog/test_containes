{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiry",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "First name of the inquirer"
    },
    "last_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Last name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country where the inquirer is located"
    },
    "inquiry_type": {
      "type": "string",
      "enum": ["new_sourcing_project", "quality_control", "supplier_verification", "shipping_logistics", "other"],
      "description": "Type of inquiry"
    },
    "product_category": {
      "type": "string",
      "maxLength": 100,
      "description": "Category of products being sourced"
    },
    "estimated_quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "product_details": {
      "type": "string",
      "maxLength": 1000,
      "description": "Details about the products to source"
    },
    "project_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional details about the project"
    }
  },
  "required": ["first_name", "last_name", "email", "company", "inquiry_type", "project_description"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
