{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full name of the contact person"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "product_category": {
      "type": "string",
      "description": "Type of products they want to source"
    },
    "estimated_annual_volume": {
      "type": "string",
      "description": "Estimated annual sourcing volume"
    },
    "message": {
      "type": "string",
      "description": "Detailed sourcing requirements or questions"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "qualified", "closed"],
      "default": "new",
      "description": "Lead status"
    },
    "user_id": {
      "type": "integer",
      "description": "Reference to the user record",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "message"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner"] },
    "update": { "allow": ["owner"] }
  },
  "x-ownerColumn": "user_id"
}
