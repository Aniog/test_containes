{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person making the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name of the inquirer"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number of the inquirer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product the buyer is looking to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated quantity needed"
    },
    "timeline": {
      "type": "string",
      "enum": ["urgent", "1-month", "2-months", "3-months", "flexible", ""],
      "description": "Preferred timeline for sourcing"
    },
    "requirements": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Detailed product requirements and specifications"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "in_progress", "quoted", "closed"],
      "default": "new",
      "description": "Status of the inquiry"
    },
    "source": {
      "type": "string",
      "default": "website",
      "description": "Source of the inquiry"
    }
  },
  "required": ["name", "email", "product", "requirements"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
