{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name of the inquirer"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number of the inquirer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product the inquirer wants to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated order quantity"
    },
    "budget": {
      "type": "string",
      "maxLength": 200,
      "description": "Target budget range"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Additional details about the sourcing requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "qualified", "converted", "closed"],
      "default": "new",
      "description": "Inquiry status in the CRM pipeline"
    }
  },
  "required": ["name", "email", "product", "message"],
  "additionalProperties": false
}