{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person making the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number"
    },
    "product_category": {
      "type": "string",
      "maxLength": 100,
      "description": "Product category the inquirer is interested in sourcing"
    },
    "estimated_quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "timeline": {
      "type": "string",
      "enum": ["urgent", "1month", "2months", "3months", "flexible", ""],
      "description": "When the products are needed"
    },
    "requirements": {
      "type": "string",
      "maxLength": 5000,
      "description": "Detailed product requirements and specifications"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "converted", "closed"],
      "default": "new",
      "description": "Status of the inquiry"
    }
  },
  "required": ["name", "email", "product_category", "requirements"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}