{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the inquiry"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 120,
      "description": "Email address for follow-up"
    },
    "company": {
      "type": "string",
      "maxLength": 120,
      "description": "Buyer company or organization name"
    },
    "country": {
      "type": "string",
      "maxLength": 80,
      "description": "Country where the buyer is based"
    },
    "product_category": {
      "type": "string",
      "maxLength": 80,
      "description": "Category of product the buyer wants to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 80,
      "description": "Estimated order quantity or volume"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed sourcing requirements or questions"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Supplier Sourcing",
          "Factory Verification",
          "Quality Inspection",
          "Production Monitoring",
          "Shipping Coordination"
        ]
      },
      "description": "Services the buyer is interested in"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the Users table if the submitter is known",
      "x-foreignKey": "users.id"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "in_progress", "quoted", "closed"],
      "default": "new",
      "description": "Status of the inquiry in the sales pipeline"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the inquiry was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the inquiry was last updated"
    }
  },
  "required": ["name", "email", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
