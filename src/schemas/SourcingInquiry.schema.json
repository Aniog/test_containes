{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Linked user record",
      "x-foreignKey": "users.id"
    },
    "fullName": {
      "type": "string",
      "minLength": 1,
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Work email"
    },
    "phone": {
      "type": "string",
      "description": "Phone number/WhatsApp"
    },
    "projectType": {
      "type": "string",
      "enum": ["Product Sourcing", "Quality Inspection", "Factory Audit", "Shipping & Logistics", "Full Sourcing Package"],
      "description": "Primary service interest"
    },
    "message": {
      "type": "string",
      "minLength": 10,
      "description": "Detailed project requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "qualified", "closed"],
      "default": "new",
      "description": "Lead status"
    }
  },
  "required": ["fullName", "email", "message"],
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
