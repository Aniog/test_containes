{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "description": "Leads and inquiries from potential clients seeking China sourcing services",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "company": {
      "type": "string",
      "maxLength": 300,
      "description": "Company name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for contact"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the buyer"
    },
    "product_type": {
      "type": "string",
      "maxLength": 500,
      "description": "Type of product being sourced"
    },
    "order_quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity range"
    },
    "target_budget": {
      "type": "string",
      "maxLength": 100,
      "description": "Target budget range"
    },
    "timeline": {
      "type": "string",
      "maxLength": 100,
      "description": "Project timeline"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of services the client needs"
    },
    "project_details": {
      "type": "string",
      "maxLength": 5000,
      "description": "Detailed description of the project requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "in_progress", "quoted", "closed"],
      "default": "new",
      "description": "Current status of the inquiry"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Internal notes about this inquiry"
    },
    "source": {
      "type": "string",
      "maxLength": 100,
      "description": "Source of the inquiry (website, referral, etc.)"
    }
  },
  "required": ["name", "email", "product_type", "project_details"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
