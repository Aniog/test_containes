{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Contact name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of origin"
    },
    "product_category": {
      "type": "string",
      "maxLength": 200,
      "description": "Product category or type being sourced"
    },
    "product_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed description of the product to be sourced"
    },
    "order_volume": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order volume or quantity"
    },
    "target_price": {
      "type": "string",
      "maxLength": 100,
      "description": "Target price per unit"
    },
    "timeline": {
      "type": "string",
      "maxLength": 100,
      "description": "Desired timeline for first order"
    },
    "services_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["supplier_search", "factory_verification", "quality_inspection", "production_follow_up", "shipping_coordination", "full_service"]
      },
      "description": "Sourcing services requested"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional message or questions"
    }
  },
  "required": ["name", "email", "product_description"],
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
