{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the person submitting the inquiry"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name of the person submitting the inquiry"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number of the person submitting the inquiry"
    },
    "product_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Type of product the buyer wants to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated quantity the buyer wants to order"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Detailed project description and requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "in_progress", "closed"],
      "default": "new",
      "description": "Current status of the inquiry"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the inquiry was submitted"
    }
  },
  "required": ["name", "email", "product_type", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
