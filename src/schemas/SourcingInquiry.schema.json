{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the inquirer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the inquirer"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the inquirer"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Product the inquirer wants to source from China"
    },
    "volume": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated order volume"
    },
    "timeline": {
      "type": "string",
      "maxLength": 200,
      "description": "Target timeline for delivery"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Additional details or specifications"
    },
    "source": {
      "type": "string",
      "enum": ["homepage_form", "contact_page"],
      "description": "Which form the inquiry came from"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewed", "responded", "qualified", "closed"],
      "default": "new",
      "description": "Status of the inquiry in the processing pipeline"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the User who submitted this inquiry",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "product"],
  "additionalProperties": false,
  "x-security": {
    "x-ownerColumn": "user_id",
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
