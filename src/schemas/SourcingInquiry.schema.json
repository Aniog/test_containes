{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for follow-up communication"
    },
    "company": {
      "type": "string",
      "maxLength": 300,
      "description": "Company or organization name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the inquiring business"
    },
    "product_category": {
      "type": "string",
      "maxLength": 200,
      "description": "Category of product the buyer is looking to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "message": {
      "type": "string",
      "maxLength": 5000,
      "description": "Product details, specifications, and requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "in_progress", "closed"],
      "default": "new",
      "description": "Status of the inquiry in the sales pipeline"
    },
    "source": {
      "type": "string",
      "maxLength": 100,
      "default": "website",
      "description": "Where the inquiry originated from"
    },
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user if logged in",
      "x-foreignKey": "users.id"
    }
  },
  "required": ["name", "email", "country", "product_category"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["owner"] },
    "update": { "allow": ["owner"] },
    "delete": { "allow": ["owner"] }
  }
}
