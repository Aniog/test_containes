{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "description": "Full name of the person submitting the inquiry"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name of the buyer"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the buyer"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number of the buyer"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the buyer"
    },
    "product_category": {
      "type": "string",
      "enum": [
        "Electronics & Components",
        "Furniture & Home Decor",
        "Textiles & Apparel",
        "Hardware & Tools",
        "Packaging & Printing",
        "Toys & Sporting Goods",
        "Beauty & Personal Care",
        "Industrial & Machinery",
        "Food & Agriculture",
        "Other"
      ],
      "description": "Product category the buyer is sourcing"
    },
    "service": {
      "type": "string",
      "enum": [
        "Supplier Sourcing",
        "Factory Verification",
        "Quality Inspection",
        "Production Follow-up",
        "Shipping Coordination",
        "Full Sourcing Package"
      ],
      "description": "Service the buyer is requesting"
    },
    "product_description": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed description of the product the buyer wants to source"
    },
    "target_price": {
      "type": "string",
      "maxLength": 100,
      "description": "Target unit price range provided by the buyer"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Order quantity or MOQ requirement"
    },
    "message": {
      "type": "string",
      "maxLength": 3000,
      "description": "Additional notes or context from the buyer"
    },
    "status": {
      "type": "string",
      "enum": ["new", "in_review", "quoted", "closed"],
      "default": "new",
      "description": "Internal status of the inquiry"
    }
  },
  "required": ["name", "email", "country", "product_category", "service", "product_description"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": [] },
    "update": { "allow": [] },
    "delete": { "allow": [] }
  }
}
