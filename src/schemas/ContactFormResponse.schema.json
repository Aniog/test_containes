{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact Form Responses",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user who submitted this form",
      "x-foreignKey": "users.id"
    },
    "firstName": {
      "type": "string",
      "maxLength": 100,
      "description": "First name of the user"
    },
    "lastName": {
      "type": "string",
      "maxLength": 100,
      "description": "Last name of the user"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address of the user"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the user"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "website": {
      "type": "string",
      "description": "Company website"
    },
    "productCategory": {
      "type": "string",
      "description": "Product category of interest"
    },
    "message": {
      "type": "string",
      "description": "Project details"
    }
  },
  "required": ["firstName", "lastName", "email", "message"],
  "x-security": {
    "create": { "allow": ["*"] }
  }
}
