{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case Studies",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "description": "Client Industry/Region"
    },
    "title": {
      "type": "string",
      "description": "Project title"
    },
    "challenge": {
      "type": "string",
      "description": "The problem solved"
    },
    "solution": {
      "type": "string",
      "description": "How we helped"
    },
    "result": {
      "type": "string",
      "description": "Outcome and statistics"
    },
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "image_id": {
      "type": "string",
      "description": "Project visual reference"
    }
  },
  "required": ["client", "title", "solution"],
  "x-security": {
    "read": { "allow": ["*"] }
  }
}
