{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case Studies",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Case study title"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "URL-friendly slug"
    },
    "client": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Client name or industry"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Product category"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Brief summary of the case study"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "Full case study content"
    },
    "results": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Key results and metrics"
    },
    "image_url": {
      "type": "string",
      "format": "uri",
      "description": "Case study image URL"
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Publication status"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    }
  },
  "required": ["id", "title", "slug", "client", "category", "summary", "content", "results"],
  "additionalProperties": false
}