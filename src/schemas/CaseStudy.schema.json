{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Case Studies",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Company name in the case study"
    },
    "industry": {
      "type": "string",
      "maxLength": 200,
      "description": "Industry category"
    },
    "location": {
      "type": "string",
      "maxLength": 200,
      "description": "Buyer location"
    },
    "challenge": {
      "type": "string",
      "maxLength": 5000,
      "description": "Description of the challenge"
    },
    "solution": {
      "type": "string",
      "maxLength": 5000,
      "description": "Solution provided"
    },
    "result": {
      "type": "string",
      "maxLength": 5000,
      "description": "Result achieved"
    },
    "metrics": {
      "type": "array",
      "description": "Key metrics demonstrating results",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    },
    "img_storage_key": {
      "type": "string",
      "maxLength": 500,
      "description": "Storage key for the case study image"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"],
      "default": "published",
      "description": "Publication status"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    }
  },
  "required": ["company", "challenge", "solution", "result"],
  "additionalProperties": false,
  "x-security": {
    "read": { "allow": ["*"] }
  }
}