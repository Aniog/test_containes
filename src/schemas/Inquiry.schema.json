{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Full name of the contact"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Company name"
    },
    "country": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Country"
    },
    "phone": {
      "type": "string",
      "maxLength": 40,
      "description": "Phone number"
    },
    "productInterest": {
      "type": "string",
      "maxLength": 120,
      "description": "Product category or interest"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Project details and requirements"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "Submission timestamp"
    }
  },
  "required": ["name", "email", "company", "country", "message"],
  "additionalProperties": false
}
