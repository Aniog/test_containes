{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Full name of the person submitting the inquiry"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Business email address"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company name"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country or region of the company"
    },
    "products": {
      "type": "string",
      "maxLength": 500,
      "description": "Products the user is looking to source"
    },
    "quantity": {
      "type": "string",
      "maxLength": 100,
      "description": "Estimated order quantity"
    },
    "message": {
      "type": "string",
      "maxLength": 2000,
      "description": "Detailed message about sourcing requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewed", "responded", "closed"],
      "default": "new",
      "description": "Status of the inquiry"
    },
    "source": {
      "type": "string",
      "enum": ["website", "blog", "referral", "other"],
      "default": "website",
      "description": "Where the inquiry originated from"
    },
    "notes": {
      "type": "string",
      "maxLength": 1000,
      "description": "Internal notes for follow-up"
    }
  },
  "required": ["name", "email", "products", "message"],
  "additionalProperties": false
}
