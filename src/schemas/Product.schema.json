{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Products",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique product identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Product display name"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "URL-safe product handle"
    },
    "price": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.01,
      "description": "Current price in USD"
    },
    "compareAtPrice": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.01,
      "description": "Original price before discount, if applicable"
    },
    "category": {
      "type": "string",
      "enum": ["earrings", "necklaces", "huggies", "sets"],
      "description": "Product category"
    },
    "material": {
      "type": "string",
      "enum": ["18k-gold-plated", "18k-gold-vermeil", "sterling-silver", "mixed"],
      "description": "Primary material or finish"
    },
    "tone": {
      "type": "string",
      "enum": ["gold", "silver", "rose-gold"],
      "description": "Metal tone family"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Short product description"
    },
    "materialsCare": {
      "type": "string",
      "maxLength": 1000,
      "description": "Materials composition and care instructions"
    },
    "shippingReturns": {
      "type": "string",
      "maxLength": 1000,
      "description": "Shipping and returns policy copy"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "multipleOf": 0.1,
      "description": "Average customer rating"
    },
    "reviewCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of reviews"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Search and filter tags"
    },
    "isBestseller": {
      "type": "boolean",
      "default": false,
      "description": "Featured on homepage bestsellers section"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "storageKey": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          }
        },
        "description": "Product image upload metadata"
      },
      "description": "Product images in display order"
    },
    "imageQuery": {
      "type": "string",
      "maxLength": 300,
      "description": "Stock image search query for this product"
    }
  },
  "required": ["name", "slug", "price", "category", "description"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["*"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
