{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blog Posts",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Blog post title"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "URL-friendly slug for the blog post"
    },
    "excerpt": {
      "type": "string",
      "maxLength": 500,
      "description": "Short summary of the blog post"
    },
    "content": {
      "type": "string",
      "description": "Full blog post content in HTML or markdown"
    },
    "category": {
      "type": "string",
      "enum": ["sourcing-tips", "industry-news", "quality-control", "shipping-logistics", "supplier-management"],
      "description": "Blog post category"
    },
    "author": {
      "type": "string",
      "maxLength": 100,
      "description": "Author name"
    },
    "published_date": {
      "type": "string",
      "format": "date",
      "description": "Publication date"
    },
    "featured_image": {
      "type": "string",
      "format": "uri",
      "description": "Featured image URL"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this post is featured"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"],
      "default": "draft",
      "description": "Publication status"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the post was created"
    }
  },
  "required": ["title", "slug", "excerpt", "content", "category", "author", "published_date"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["admin"] },
    "read": { "allow": ["*"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
