{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact Inquiries",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Full name of the person making the inquiry"
    },
    "company": {
      "type": "string",
      "maxLength": 300,
      "description": "Company or organization name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address for follow-up"
    },
    "phone": {
      "type": "string",
      "maxLength": 50,
      "description": "Phone number with country code"
    },
    "country": {
      "type": "string",
      "maxLength": 100,
      "description": "Country of the inquirer"
    },
    "product_interest": {
      "type": "string",
      "maxLength": 500,
      "description": "Type of product the buyer is interested in sourcing"
    },
    "quantity": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated order quantity"
    },
    "budget": {
      "type": "string",
      "maxLength": 200,
      "description": "Estimated budget range"
    },
    "message": {
      "type": "string",
      "maxLength": 5000,
      "description": "Additional details or specific requirements"
    },
    "source": {
      "type": "string",
      "enum": ["website", "referral", "social_media", "search_engine", "trade_show", "other"],
      "default": "website",
      "description": "How the inquirer found SSourcing China"
    },
    "status": {
      "type": "string",
      "enum": ["new", "contacted", "quoted", "converted", "closed"],
      "default": "new",
      "description": "Current status of the inquiry"
    }
  },
  "required": ["name", "email", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
