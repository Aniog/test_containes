{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact Inquiries",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reference to the user record",
      "x-foreignKey": "users.id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "product_name": {
      "type": "string",
      "description": "Product name or category"
    },
    "order_quantity": {
      "type": "string",
      "description": "Estimated order quantity"
    },
    "target_price": {
      "type": "string",
      "description": "Target unit price"
    },
    "message": {
      "type": "string",
      "description": "Detailed requirements"
    }
  },
  "required": ["name", "email", "product_name", "message"],
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
