{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sourcing Inquiries",
  "type": "object",
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "First Name"
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Last Name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Work Email"
    },
    "company": {
      "type": "string",
      "maxLength": 200,
      "description": "Company Name"
    },
    "interest": {
      "type": "string",
      "enum": ["sourcing", "audit", "inspection", "logistics", "other"],
      "description": "Service of interest"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "Product Details & Requirements"
    },
    "status": {
      "type": "string",
      "enum": ["new", "reviewing", "quoted", "closed"],
      "default": "new",
      "description": "Inquiry status"
    }
  },
  "required": ["firstName", "lastName", "email", "interest", "message"],
  "additionalProperties": false,
  "x-security": {
    "create": { "allow": ["*"] },
    "read": { "allow": ["admin"] },
    "update": { "allow": ["admin"] },
    "delete": { "allow": ["admin"] }
  }
}
